{
  "manifest_version": 3,
  "name": "BeHeld",
  "version": "0.1.0",
  "description": "Capture, crop, organize, and save screenshots locally from any webpage.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "offscreen"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "BeHeld",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "take-screenshot": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture a screenshot of the current tab"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  }
}
